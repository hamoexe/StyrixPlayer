<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/player_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingBottom="16dp">

        <!-- top bar: close, speed badge, quick settings toggle -->
        <LinearLayout
            android:id="@+id/player_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close player"
                android:src="@drawable/ic_expand_more"
                android:tint="?attr/colorOnSurface" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/speed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_video"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Video"
                android:src="@drawable/ic_video"
                android:tint="?attr/colorOnSurface"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_lyrics"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Lyrics"
                android:src="@drawable/ic_lyrics"
                android:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_tune"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quick settings"
                android:src="@drawable/ic_tune"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- artwork; the lyrics view sits on top of it (same size) and takes over when switched on -->
        <FrameLayout
            android:id="@+id/art_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginTop="20dp">

            <!-- soft shadow: bigger than the cover and nudged down, drawn behind it -->
            <ImageView
                android:id="@+id/art_shadow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="-26dp"
                android:layout_marginTop="-18dp"
                android:layout_marginEnd="-26dp"
                android:layout_marginBottom="-34dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/art"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/bg_art"
                android:clipToOutline="true"
                android:contentDescription="Album art"
                android:elevation="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_art_placeholder" />

            <!-- the video of a streamed song: sits at the top of the frame, lyrics go under it -->
            <FrameLayout
                android:id="@+id/video_box"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_art"
                android:clipToOutline="true"
                android:visibility="gone">

                <TextureView
                    android:id="@+id/video_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />
            </FrameLayout>

            <com.hamo.styrixplayer.ui.LyricsView
                android:id="@+id/lyrics_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="0dp"
                android:visibility="gone" />
                    <!-- quick settings: floats over the cover so the controls below never move -->
            <LinearLayout
                android:id="@+id/quick_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_panel"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/speed_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Speed 1.0x"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_speed_reset"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/speed_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="0.05"
                    android:value="1.0"
                    android:valueFrom="0.5"
                    android:valueTo="2.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pitch changes with speed"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="On: classic slowed / sped-up sound. Off: original pitch."
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_pitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_metadata"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Edit metadata"
                    app:icon="@drawable/ic_edit" />

            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tag_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_fav"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favorite"
                android:src="@drawable/ic_favorite_border" />

            <ImageButton
                android:id="@+id/btn_playlist"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add to playlist"
                android:src="@drawable/ic_playlist_add"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <com.hamo.styrixplayer.ui.HeatBar
            android:id="@+id/heat_bar"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="14dp"
            android:visibility="invisible" />

        <com.google.android.material.slider.Slider
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:valueFrom="0.0"
            android:valueTo="1.0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView
                android:id="@+id/total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_shuffle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_player_icon_button"
                    android:contentDescription="Shuffle"
                    android:src="@drawable/ic_shuffle"
                    android:tint="?attr/colorOnSurface" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_player_icon_button"
                    android:contentDescription="Previous"
                    android:src="@drawable/ic_skip_previous"
                    android:tint="?attr/colorOnSurface" />
            </FrameLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Play or pause"
                android:src="@drawable/ic_play"
                app:borderWidth="0dp"
                app:elevation="0dp"
                app:fabCustomSize="82dp"
                app:hoveredFocusedTranslationZ="0dp"
                app:maxImageSize="40dp"
                app:pressedTranslationZ="0dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_player_icon_button"
                    android:contentDescription="Next"
                    android:src="@drawable/ic_skip_next"
                    android:tint="?attr/colorOnSurface" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_repeat"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_player_icon_button"
                    android:contentDescription="Repeat"
                    android:src="@drawable/ic_repeat"
                    android:tint="?attr/colorOnSurface" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="Queue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sleep"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="Sleep timer" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
